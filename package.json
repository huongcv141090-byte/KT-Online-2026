{
  "name": "openremotehub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --filter @orh/web dev",
    "build": "pnpm --filter @orh/web build",
    "build:all": "turbo run build",
    "start": "pnpm --filter @orh/web start",
    "lint": "pnpm --filter @orh/web lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "prettier": "^3.2.0",
    "eslint": "^8.57.0"
  }
}
